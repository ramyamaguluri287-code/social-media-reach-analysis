# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration (Optional MongoDB - Falls back to mock data if not running)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=social_reach_db
ENABLE_MOCK_FALLBACK=true

# Social API Credentials (Optional - Mock data used when empty)
INSTAGRAM_BASIC_DISPLAY_TOKEN=
YOUTUBE_DATA_API_KEY=
TWITTER_BEARER_TOKEN=

# Alert Simulation
NOTIFICATION_EMAIL_RECIPIENT=marketing-team@example.com
NOTIFICATION_WHATSAPP_NUMBER=+1234567890
